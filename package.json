{
  "name": "veksnap-app",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build.js",
    "start": "next start",
    "lint": "eslint",
    "launch": "node launcher.mjs",
    "launch:prod": "npm run build && node launcher.mjs --prod",
    "shell": "set ELECTRON_RUN_AS_NODE= && electron shell",
    "package": "npm run build && npx pkg launcher.mjs --targets node18-win-x64 --output ../VekSnap.exe --config pkg.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exif-be-gone": "^1.5.1",
    "exifreader": "^4.40.3",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.6.5",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "tar": "^7.5.22",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "docx": "^9.6.1",
    "electron": "^33.4.11",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
